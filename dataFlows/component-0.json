      "type": "System",
      "nodes": [
        {
          "id": "2bb4855c-e400-432e-9504-b0a9eb8b8209",
          "name": "Get History without end dates",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "{}",
            "query": "{\n  workunitStateHistory(where: {endAt: {_isNull: true}}) {\n    edges {\n      node {\n        id\n        workunitId\n        occurAt\n      }\n    }\n  }\n}",
            "nextNodes": [
              "17a85503-42c1-45ba-a64b-cb88e437e4a2"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "17a85503-42c1-45ba-a64b-cb88e437e4a2",
          "name": "Calculate End Dates",
          "type": "transform",
          "data": {
            "transform": "$groupBy(\n  workunitStateHistory.edges.node[$isNil(occurAt)~>$not]^(occurAt), \n  $path(?, \"workunitId\")\n)\n~>$mapValues(function($j){\n  $count($j) > 1?(\n    $map($j, function($v, $i, $arr){(\n \n    $arr[$i +1]?(\n     $start := $moment($v.occurAt);\n     $end := $moment($arr[$i +1].occurAt);\n\n\n     {\n        \"where\":{ \"id\": $v.id},\n        \"update\":{\n          \"endAt\": $end.toISOString(),\n          \"duration\": $end.diff($start, \"seconds\")\n        }\n      }\n    )\n    )})\n  )\n})\n~>$values\n~>$filter($isNil~>$not)\n~>$flatten()\n\n\n",
            "nextNodes": [
              "aeb7cadb-d58a-4c57-987c-d596518bdc0d"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "aeb7cadb-d58a-4c57-987c-d596518bdc0d",
          "name": "Update End Dates",
          "type": "mutate",
          "data": {
            "api": "Application",
            "variablesTransform": "{\n  \"payload\": $\n}",
            "mutation": "mutation ($payload: [WorkunitStateHistoryUpdatePayloadInput!]!){\n  updateWorkunitStateHistory(payload:$payload){ id }\n}",
            "nextNodes": []
          },
