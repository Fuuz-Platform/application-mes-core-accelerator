{
  "header": {
    "id": "productionSetupOutput",
    "name": "ProductionSetupOutput",
    "description": "Represents the expected output products from a workunit during an active production run. This model maintains the current state of what products are being manufactured, their quantities, and production progress. Multiple outputs can be produced simultaneously on a single workunit, and validated against the workUnit concurrency.\n\nThis output is defined by the WorkOrderProcessDistribution that is dispatched to the workcenter. At that point, this record is created. When the run is complete, and the output is no longer required, it is deleted from this table.",
    "dataModelKindId": "reference",
    "_customFields": {
      "_externalId": null
    }
  },
